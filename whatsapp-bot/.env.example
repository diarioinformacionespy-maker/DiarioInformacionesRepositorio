# Copiá este archivo como .env y completá.

# Tu número (solo dígitos, con código de país) para recibir avisos cuando un cliente pide una persona.
# Tiene que ser OTRO número, no el del bot.
ADMIN_NUMBER=595981000000

# Opcional: si lo completás con el número del bot, en vez de QR te da un código de 8 dígitos para vincular.
PAIRING_NUMBER=

BOT_NOMBRE=Diario Informaciones
TZ_ATENCION=America/Asuncion
HORA_INICIO=7
HORA_FIN=14

# Cuántas horas se calla el bot en un chat cuando una persona del equipo responde a mano.
HORAS_PAUSA=12

LOG_LEVEL=warn

# IA (Gemini, plan gratis de Google AI Studio). La clave va SOLO en el .env del servidor.
GEMINI_API_KEY=
GEMINI_MODELOS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# Hora de cierre para la fecha tentativa (regla del Pool)
HORA_CIERRE=14
TEMPORADA_BAJA=1

# Claude (respuestas). Si falta, responde Gemini.
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5   (más barato: claude-sonnet-5-5 o claude-haiku-5-5)
# CLAUDE_ESFUERZO=low

# Alertas al equipo (números que reciben las alertas de la carpeta del Drive; el bot no les contesta como a clientes)
ALERTAS_DESTINOS=
# Cierre del día para gerencia (si falta CIERRE_DESTINOS, va a ALERTAS_DESTINOS)
# CIERRE_HORA=18:30
# CIERRE_DESTINOS=
